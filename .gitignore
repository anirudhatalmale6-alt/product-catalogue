# Your live database credentials - never commit this.
app/config.php

# Images uploaded through the admin panel are NOT committed - they are your
# data, not the application.
#
# The generated placeholder plates are the exception. They are committed
# because sql/catalogue_data.sql points every product at one, and a deployment
# done through cPanel File Manager and phpMyAdmin has no command line to run
# tools/generate_placeholder_images.php on. Without them a fresh install would
# come up with 213 broken images.
public/uploads/products/*
!public/uploads/products/catalogue/

