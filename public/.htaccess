# ---------------------------------------------------------------------------
# Pretty URLs. Everything that is not a real file or folder is handed to
# index.php, which works out the route.
# If your host has mod_rewrite switched off the site still works - the URLs
# just look like /index.php?r=product/slug instead.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Uncomment and set if the site lives in a sub-folder and links misbehave.
    # RewriteBase /catalogue/

    # --- Force HTTPS --------------------------------------------------------
    # Uncomment these three lines once a certificate is working. They belong
    # together with 'https_only' => true in app/config.php: that flag marks the
    # admin session cookie "secure", so a visitor who arrives over plain http
    # never sends it back. Without the redirect the admin login looks like it
    # silently fails - you sign in and land back on the login page.
    # Leave them commented while developing over http on localhost, or every
    # request will bounce to an https address that is not listening.
    # The acme-challenge exemption keeps the certificate's own renewal check
    # reachable over http, which Let's Encrypt needs.
    # RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Send everything that is not an existing file or directory to the router.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# --- Do not list folders ----------------------------------------------------
Options -Indexes

# --- Default document -------------------------------------------------------
DirectoryIndex index.php

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# --- Cache static assets ----------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css            "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg          "access plus 30 days"
    ExpiresByType image/png           "access plus 30 days"
    ExpiresByType image/webp          "access plus 30 days"
    ExpiresByType image/svg+xml       "access plus 30 days"
</IfModule>

# --- Never serve dot-files --------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
